---
import Base from './Base.astro';
import ProjectVisual from '../components/ProjectVisual.astro';
interface Props {
  frontmatter: { title: string; summary: string; category: string; kind: 'studio' | 'uniflow' | 'localflow'; stack: string[]; repo: string; metric: string; metricLabel: string };
}
const { frontmatter: project } = Astro.props;
const base = import.meta.env.BASE_URL;
---
<Base title={`${project.title} — Kushagra Garg`} description={project.summary}>
  <article class="case-study wrap">
    <a class="back-link" href={`${base}#work`}><span aria-hidden="true">←</span> All projects</a>
    <header class="case-header"><p class="project-category">{project.category}</p><h1>{project.title}</h1><p class="case-summary">{project.summary}</p><a class="button primary" href={project.repo}>Explore the code <span aria-hidden="true">↗</span></a></header>
    <ProjectVisual kind={project.kind} />
    <div class="case-body"><aside class="case-sidebar"><h2>Built with</h2><ul class="stack-list">{project.stack.map(item => <li>{item}</li>)}</ul><div class="case-metric"><strong>{project.metric}</strong><span>{project.metricLabel}</span></div><p class="metric-note">Project evaluation reported in my résumé. Results depend on the test setup and workload.</p></aside><div class="prose"><slot /></div></div>
    <div class="case-end"><h2>Want to dig into the details?</h2><p>Explore the implementation, open an issue, or get in touch.</p><div class="actions"><a class="button primary" href={project.repo}>View on GitHub <span aria-hidden="true">↗</span></a><a class="text-link" href="mailto:Kushagragarg14@gmail.com">Email me</a></div></div>
  </article>
</Base>
