---
import '@fontsource-variable/archivo';
import '@fontsource-variable/newsreader';
import '../styles/global.css';
interface Props { title?: string; description?: string }
const { title = 'Kushagra Garg — Software & AI', description = 'Computer science student at the University of Georgia, building AI tools and useful open-source software. Explore Studio, UniFlow, and LocalFlow.' } = Astro.props;
const base = import.meta.env.BASE_URL;
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site) : undefined;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#F7F8F4" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {Astro.site && <meta property="og:image" content={new URL(`${base}profile.jpg`, Astro.site).href} />}
    {canonical && <><link rel="canonical" href={canonical} /><meta property="og:url" content={canonical} /></>}
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header wrap">
      <a class="wordmark" href={base} aria-label="Kushagra Garg, home">Kushagra Garg<span class="wordmark-dot" aria-hidden="true">.</span></a>
      <nav aria-label="Main navigation">
        <a href={`${base}#work`}>Work</a>
        <a href={`${base}#about`}>About</a>
        <a href={`${base}#contact`}>Contact</a>
        <a class="resume-link" href={`${base}Kushagra-Garg-Resume.pdf`} target="_blank" rel="noopener">Résumé <span aria-hidden="true">↗</span><span class="sr-only"> (PDF, opens in a new tab)</span></a>
      </nav>
    </header>
    <main id="main"><slot /></main>
    <footer class="site-footer wrap">
      <a class="wordmark" href={base}>Kushagra Garg<span class="wordmark-dot" aria-hidden="true">.</span></a>
      <p>Built with care in Athens, Georgia.</p>
      <a href="#main">Back to top <span aria-hidden="true">↑</span></a>
    </footer>
  </body>
</html>
