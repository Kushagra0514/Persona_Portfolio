---
import type { MarkdownInstance } from 'astro';
import Base from '../layouts/Base.astro';
import ProjectVisual from '../components/ProjectVisual.astro';
type Project = { title: string; kind: 'studio' | 'uniflow' | 'localflow'; order: number; category: string; summary: string; stack: string[]; repo: string; highlight: string };
const projects = Object.values(import.meta.glob<MarkdownInstance<Project>>('./projects/*.md', { eager: true })).sort((a,b) => a.frontmatter.order - b.frontmatter.order);
const base = import.meta.env.BASE_URL;
---
<Base>
  <section class="hero wrap" aria-labelledby="hero-title">
    <div class="hero-copy"><p class="intro-line"><span aria-hidden="true"></span> Software, AI, and a little curiosity.</p><h1 id="hero-title">Making complex<br class="desktop-break"/> things feel<br class="desktop-break"/> simple.</h1><p class="hero-description">I’m Kushagra, a computer science student at UGA. I build AI tools and open-source software that help people find answers, see the bigger picture, and get things done.</p><div class="actions"><a class="button primary" href="#work">Explore my work <span aria-hidden="true">↓</span></a><a class="text-link" href="https://github.com/Kushagra0514">Find me on GitHub <span aria-hidden="true">↗</span></a></div></div>
    <figure class="portrait"><div class="portrait-frame"><img src={`${base}profile.jpg`} alt="Kushagra Garg standing beside a lake" width="400" height="400" fetchpriority="high" /></div><figcaption><div><strong>Kushagra Garg</strong><span>Athens, Georgia</span></div><svg viewBox="0 0 48 48" fill="none" aria-hidden="true"><path d="M24 4v40M4 24h40M10 10l28 28M10 38l28-28" stroke="currentColor" stroke-width="2"/></svg></figcaption></figure>
    <div class="hero-foot"><span>Computer Science at the University of Georgia</span><span>Open to internships & collaboration</span></div>
  </section>
  <section class="work wrap" id="work" aria-labelledby="work-title">
    <div class="section-heading"><div><p class="section-kicker">Ideas into working software</p><h2 id="work-title">Selected work.</h2></div><p>Three projects. A shared interest in<br/> making technology more useful.</p></div>
    <div class="project-grid">{projects.map(({ frontmatter: p }) => <article class:list={['project-card', { featured: p.kind === 'studio' }]}>
      <a class="project-art-link" href={`${base}projects/${p.kind}/`} aria-label={`Read the ${p.title} case study`}><ProjectVisual kind={p.kind}/></a>
      <div class="project-info"><p class="project-category">{p.category}</p><h3><a href={`${base}projects/${p.kind}/`}>{p.title}<span aria-hidden="true">↗</span></a></h3><p class="project-description">{p.summary}</p><ul class="tags" aria-label={`${p.title} technologies`}>{p.stack.slice(0,4).map(tag => <li>{tag}</li>)}</ul><div class="project-bottom"><span>{p.highlight}</span><a href={`${base}projects/${p.kind}/`}>Case study <span aria-hidden="true">↗</span></a></div></div>
    </article>)}</div>
    <p class="work-note">Curious about the implementation? <a href="https://github.com/Kushagra0514">Explore my repositories on GitHub <span aria-hidden="true">↗</span></a></p>
  </section>
  <section class="about-section" id="about" aria-labelledby="about-title"><div class="wrap about-grid"><div class="about-copy"><p class="section-kicker">A little about me</p><h2 id="about-title">Curious by nature.<br/>Hands-on by choice.</h2><p>I’m studying computer science at the University of Georgia, with an emphasis in artificial intelligence and an expected graduation in May 2028.</p><p>My projects connect AI with everyday workflows: searching documents, understanding a degree, and turning speech into text. I like working through the full problem, from the model and backend to the interface someone actually uses.</p><a class="text-link" href={`${base}Kushagra-Garg-Resume.pdf`} target="_blank" rel="noopener">Read my résumé <span aria-hidden="true">↗</span><span class="sr-only"> (PDF, opens in a new tab)</span></a></div><div class="background-details"><div class="detail-group"><h3>What I work with</h3><dl><div><dt>Languages</dt><dd>Python, Java, JavaScript, C/C++</dd></div><div><dt>Web & systems</dt><dd>React, FastAPI, Vite, Docker, Git</dd></div><div><dt>AI & machine learning</dt><dd>PyTorch, TensorFlow, Scikit-learn, Qdrant, Ollama, WebLLM</dd></div></dl></div><div class="detail-group"><h3>Continuing to learn</h3><p>Machine Learning with Python<br/><span>Anaconda · Professional Certificate, May 2026</span></p><p>Microsoft Azure AI Essentials<br/><span>Microsoft & LinkedIn · Professional Certificate, May 2026</span></p></div></div></div></section>
  <section class="contact wrap" id="contact" aria-labelledby="contact-title"><div><p class="section-kicker">Good work starts with a conversation</p><h2 id="contact-title">Let’s build<br/>something useful.</h2><p>Have an internship opportunity, an open-source idea,<br class="desktop-break"/> or a question about a project? I’d love to hear from you.</p><a class="email-link" href="mailto:Kushagragarg14@gmail.com">Kushagragarg14@gmail.com <span aria-hidden="true">↗</span></a></div><div class="contact-links"><a href="https://github.com/Kushagra0514">GitHub <span aria-hidden="true">↗</span></a><a href="https://linkedin.com/in/gargkushagra">LinkedIn <span aria-hidden="true">↗</span></a><a href={`${base}Kushagra-Garg-Resume.pdf`} target="_blank" rel="noopener">Résumé <span aria-hidden="true">↗</span><span class="sr-only"> (PDF, opens in a new tab)</span></a></div></section>
</Base>
